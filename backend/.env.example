# ==============================================================================
# Stemly Backend — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit .env to version control! Never log API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# Groq LLM Configuration (Unified AI Layer)
# ------------------------------------------------------------------------------
# Get your Groq API keys from: https://console.groq.com/keys
GROQ_VISION_API_KEY=gsk_your_groq_vision_key_here
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

GROQ_TEXT_API_KEY=gsk_your_groq_text_key_here
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Operational timeouts, retries, and cost quotas
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3
DAILY_LLM_QUOTA=50

# ------------------------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------------------------
# Connection string for MongoDB Atlas or a local instance:
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
# Local: mongodb://localhost:27017/stemly
MONGO_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/stemly?retryWrites=true&w=majority
MONGO_ALLOW_INVALID_CERTS=false

# ------------------------------------------------------------------------------
# Firebase Authentication
# ------------------------------------------------------------------------------
# Option 1: Path to your Firebase service account JSON key file
FIREBASE_CREDENTIALS_FILE=serviceAccountKey.json

# Option 2: Full JSON blob as a single-line string (useful for CI/deployment)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"stemly-xxxxx", ...}

# ------------------------------------------------------------------------------
# Server / Testing Configuration
# ------------------------------------------------------------------------------
# Set to "true" during automated tests to bypass strict key validation
TESTING=false
HOST=0.0.0.0
PORT=8080
