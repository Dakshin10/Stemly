# ==============================================================================
# Stemly Backend — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit .env to version control! Never log API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# Groq LLM Configuration (Unified AI Layer)
# ------------------------------------------------------------------------------
# Get your Groq API keys from: https://console.groq.com/keys
GROQ_VISION_API_KEY=gsk_your_groq_vision_key_here
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

GROQ_TEXT_API_KEY=gsk_your_groq_text_key_here
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Operational timeouts, retries, and cost quotas
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3
DAILY_LLM_QUOTA=50

# ------------------------------------------------------------------------------
# AI Tutor Chat Hardening & Circuit Breaker Settings
# ------------------------------------------------------------------------------
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0
CHAT_CACHE_ENABLED=true
CHAT_CACHE_TTL_SECONDS=3600
CHAT_MAX_CONTEXT_TOKENS=3000

# ------------------------------------------------------------------------------
# MongoDB & Connection Pooling
# ------------------------------------------------------------------------------
# Connection string for MongoDB Atlas or a local instance:
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
# Local: mongodb://localhost:27017/stemly
MONGO_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/stemly?retryWrites=true&w=majority
MONGO_ALLOW_INVALID_CERTS=false
MONGO_MAX_POOL_SIZE=25
MONGO_MIN_POOL_SIZE=5

# ------------------------------------------------------------------------------
# Distributed Redis (SlowAPI Rate Limiting & Session Caching across workers)
# ------------------------------------------------------------------------------
# Leave empty for local in-memory fallback; provide for multi-worker production
REDIS_URL=rediss://default:your_redis_password@your-redis-host.upstash.io:6379

# ------------------------------------------------------------------------------
# Cloud Object Storage (Cloudflare R2 / AWS S3 for zero-loss scan persistence)
# ------------------------------------------------------------------------------
# Leave empty for local disk fallback (static/scans); provide for container production
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=stemly-scans-production
S3_ACCESS_KEY_ID=your_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
S3_REGION_NAME=auto
S3_PUBLIC_DOMAIN=https://cdn.stemly.app

# ------------------------------------------------------------------------------
# Secondary LLM Failover (Google Gemini Flash for 429 resiliency)
# ------------------------------------------------------------------------------
# Optional: If Groq hits 429 rate limit or outage, automatically fails over to Gemini
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_VISION_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Firebase Authentication
# ------------------------------------------------------------------------------
# Option 1: Path to your Firebase service account JSON key file
FIREBASE_CREDENTIALS_FILE=serviceAccountKey.json

# Option 2: Full JSON blob as a single-line string (useful for CI/deployment)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"stemly-xxxxx", ...}

# ------------------------------------------------------------------------------
# Server / Testing / Security Configuration
# ------------------------------------------------------------------------------
# Set to "false" in production to forbid mock auth bypass tokens
ALLOW_DEV_AUTH_BYPASS=false
TESTING=false
HOST=0.0.0.0
PORT=8080
